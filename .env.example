# Copy this file to `.env` and fill in the values.
# Used by `bun run readings:new` (scripts/generate-reading.ts).

# Internal integration secret from https://app.notion.com/developers/tokens
# The integration must be shared with the "Articles" database.
NOTION_TOKEN=

# The "Articles" database. Accepts a bare ID, a dashed UUID, or the full Notion URL.
NOTION_DATABASE_ID=
